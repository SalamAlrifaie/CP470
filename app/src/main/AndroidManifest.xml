<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.INTERNET" />

    <uses-feature
        android:name="android.hardware.camera"
        android:required="true" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.AndroidAssignments"
        tools:targetApi="31">
        <activity
            android:name=".MessageDetails"
            android:exported="false" />
        <activity
            android:name=".WeatherForecast"
            android:exported="false"
            android:label="@string/weather"
            android:parentActivityName=".MainActivity" />
        <activity
            android:name=".MainActivity"
            android:exported="false"
            android:label="@string/LabelMain"
            android:parentActivityName=".LoginActivity" />
        <activity
            android:name=".TestToolbar"
            android:exported="true"
            android:theme="@style/Theme.TestToolbar" />

        <meta-data
            android:name="android.support.PARENT_ACTIVITY"
            android:value=".LoginActivity" /> <!-- chat activity -->
        <activity
            android:name=".ChatWindow"
            android:exported="true"
            android:label="@string/LabelChat"
            android:parentActivityName=".MainActivity"
            android:windowSoftInputMode="adjustResize" >
            <!-- INTENT FILTER -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity><!-- list items activity -->
        <activity
            android:name=".ListItemsActivity"
            android:exported="true"
            android:label="@string/LabelListItems"
            android:parentActivityName=".MainActivity" /> <!-- login activity (home screen) -->
        <activity
            android:name=".LoginActivity"
            android:exported="true"/>

    </application>

</manifest>