<?xml version="1.0" encoding="utf-8"?>
<resources>
        <!-- Define a custom button style -->
        <style name="CustomButtonStyle" parent="Widget.AppCompat.Button">
            <!-- Set the height of the button -->
            <item name="android:layout_height">48dp</item>
            <!-- Set the padding inside the button (left, top, right, bottom) -->
            <item name="android:padding">16dp</item>
            <!-- Set the margin around the button -->
            <item name="android:layout_margin">8dp</item>
            <!-- Set the font size of the button text -->
            <item name="android:textSize">16sp</item>
            <!-- Set the font color of the button text -->
            <item name="android:textColor">#000000</item>
            <!-- Set the background color of the button -->
            <item name="android:background">#FF97C1</item>
            <!-- Bold the text inside the button -->
            <item name="android:textStyle">bold</item>
        </style>
</resources>